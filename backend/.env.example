# Copy to .env and fill in real values.

# --- App ---
ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# --- PostgreSQL (app data + langgraph checkpointer + pgvector) ---
DATABASE_DSN=postgresql+psycopg://admin:123456@127.0.0.1:5432/default_db
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# --- RustFS (S3-compatible object storage) ---
RUSTFS_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=agent-files

# --- OpenSandbox pool ---
OPENSANDBOX_DOMAIN=
OPENSANDBOX_API_KEY=
OPENSANDBOX_IMAGE=opensandbox/code-interpreter:v1.1.0
OPENSANDBOX_MAX_IDLE=3
OPENSANDBOX_USE_SERVER_PROXY=true
SANDBOX_TTL_SECONDS=600
SANDBOX_EXECUTE_TIMEOUT=120

# --- LLM (OpenAI-compatible: DeepSeek / Doubao / GLM / ...) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_SUPPORTS_VISION=false

# --- Embedding (independent OpenAI-compatible endpoint) ---
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16

# --- Agent ---
AGENT_TODOS_ENABLED=false
MAX_CONCURRENT_AGENTS_PER_USER=4

# --- Zhipu Web Search ---
ZHIPU_API_KEY=

# --- RAG ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_RESULTS=5
RAG_MAX_FILE_BYTES=52428800

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
